{
  "manifest_version": 3,
  "key": "",
  "name": "AI Browser Assistant",
  "version": "0.1.0",
  "description": "Form filling, summarization, and Gmail/Calendar assistance.",

  "permissions": ["storage", "activeTab", "scripting", "identity"],

  "host_permissions": [
    "http://localhost:11434/*",
    "https://*.workers.dev/*",
    "https://www.googleapis.com/*"
  ],

  "oauth2": {
    "client_id": "1029335278060-m33q1k0ju2lt3bt3fo5rnm43b4lftl13.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/gmail.readonly",
      "https://www.googleapis.com/auth/gmail.send",
      "https://www.googleapis.com/auth/calendar.events"
    ]
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["storage.js", "field-matcher.js", "content.js"],
      "css": ["overlay.css"]
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Browser Assistant"
  },

  "options_page": "options.html",

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}