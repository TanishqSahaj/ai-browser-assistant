{
  "manifest_version": 3,
  "name": "AI Browser Assistant",
  "version": "0.1.0",
  "description": "Phase 4 - LLM integration (local Ollama, Ollama Cloud, or Hugging Face).",

  "permissions": ["storage", "activeTab", "scripting"],

  "host_permissions": [
    "http://localhost:11434/*",
    "https://*.workers.dev/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["storage.js", "field-matcher.js", "content.js"],
      "css": ["overlay.css"]
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Browser Assistant"
  },

  "options_page": "options.html",

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}